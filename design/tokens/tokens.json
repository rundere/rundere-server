{
  "$description": "Rundere design tokens — source of truth. tokens.css, RundereTheme.swift and RundereTheme.kt are hand-kept mirrors of this file; change all four together.",
  "color": {
    "night": {
      "950": { "$type": "color", "$value": "#070F19" },
      "900": { "$type": "color", "$value": "#0A1624" },
      "800": { "$type": "color", "$value": "#0F2135" },
      "700": { "$type": "color", "$value": "#16304A" },
      "600": { "$type": "color", "$value": "#22405F" },
      "500": { "$type": "color", "$value": "#35557A" },
      "400": { "$type": "color", "$value": "#4F6F94" }
    },
    "silver": {
      "50":  { "$type": "color", "$value": "#F4F6F9" },
      "100": { "$type": "color", "$value": "#E6EAF0" },
      "200": { "$type": "color", "$value": "#CBD3DD" },
      "300": { "$type": "color", "$value": "#AAB6C4" },
      "400": { "$type": "color", "$value": "#8594A6" },
      "500": { "$type": "color", "$value": "#5E6E82" },
      "600": { "$type": "color", "$value": "#44536A" }
    },
    "beacon": {
      "100": { "$type": "color", "$value": "#E3EEFF" },
      "200": { "$type": "color", "$value": "#C7DDFF" },
      "300": { "$type": "color", "$value": "#A9CCFF" },
      "400": { "$type": "color", "$value": "#7FB2FF" },
      "500": { "$type": "color", "$value": "#4F8FEA" },
      "600": { "$type": "color", "$value": "#2F6FD6" },
      "700": { "$type": "color", "$value": "#1F57B0" }
    },
    "runway": {
      "100": { "$type": "color", "$value": "#FDF1D8" },
      "200": { "$type": "color", "$value": "#FADFA6" },
      "300": { "$type": "color", "$value": "#F6CB72" },
      "400": { "$type": "color", "$value": "#F2B544" },
      "500": { "$type": "color", "$value": "#D9951C" },
      "600": { "$type": "color", "$value": "#B07810" },
      "700": { "$type": "color", "$value": "#8A5C08" }
    },
    "status": {
      "success-400": { "$type": "color", "$value": "#4CC38A" },
      "success-600": { "$type": "color", "$value": "#1E7F52" },
      "danger-400":  { "$type": "color", "$value": "#F2766B" },
      "danger-600":  { "$type": "color", "$value": "#C23B30" }
    }
  },
  "semantic": {
    "$description": "Use these in UI code, never the raw ramps. dark is the designed default.",
    "dark": {
      "bg":             { "$type": "color", "$value": "{color.night.900}" },
      "surface":        { "$type": "color", "$value": "{color.night.800}" },
      "surface-raised": { "$type": "color", "$value": "{color.night.700}" },
      "border":         { "$type": "color", "$value": "{color.night.600}" },
      "border-subtle":  { "$type": "color", "$value": "rgba(170,182,196,0.14)" },
      "text":           { "$type": "color", "$value": "{color.silver.100}" },
      "text-secondary": { "$type": "color", "$value": "{color.silver.300}" },
      "text-muted":     { "$type": "color", "$value": "{color.silver.400}" },
      "accent":         { "$type": "color", "$value": "{color.beacon.400}" },
      "accent-hover":   { "$type": "color", "$value": "{color.beacon.300}" },
      "on-accent":      { "$type": "color", "$value": "{color.night.900}" },
      "highlight":      { "$type": "color", "$value": "{color.runway.400}" },
      "success":        { "$type": "color", "$value": "{color.status.success-400}" },
      "danger":         { "$type": "color", "$value": "{color.status.danger-400}" },
      "focus-ring":     { "$type": "color", "$value": "{color.beacon.300}" }
    },
    "light": {
      "bg":             { "$type": "color", "$value": "{color.silver.50}" },
      "surface":        { "$type": "color", "$value": "#FFFFFF" },
      "surface-raised": { "$type": "color", "$value": "#FFFFFF" },
      "border":         { "$type": "color", "$value": "{color.silver.200}" },
      "border-subtle":  { "$type": "color", "$value": "rgba(15,33,53,0.10)" },
      "text":           { "$type": "color", "$value": "{color.night.800}" },
      "text-secondary": { "$type": "color", "$value": "{color.silver.600}" },
      "text-muted":     { "$type": "color", "$value": "{color.silver.500}" },
      "accent":         { "$type": "color", "$value": "{color.beacon.700}" },
      "accent-hover":   { "$type": "color", "$value": "{color.beacon.600}" },
      "on-accent":      { "$type": "color", "$value": "#FFFFFF" },
      "highlight":      { "$type": "color", "$value": "{color.runway.700}" },
      "success":        { "$type": "color", "$value": "{color.status.success-600}" },
      "danger":         { "$type": "color", "$value": "{color.status.danger-600}" },
      "focus-ring":     { "$type": "color", "$value": "{color.beacon.600}" }
    }
  },
  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": ["Outfit", "system-ui", "sans-serif"] },
      "body":    { "$type": "fontFamily", "$value": ["Figtree", "system-ui", "sans-serif"] },
      "mono":    { "$type": "fontFamily", "$value": ["JetBrains Mono", "ui-monospace", "monospace"] }
    },
    "scale": {
      "$description": "Web scale: size / line-height px · weight. iOS and Android mappings are in design/README.md.",
      "display":  { "family": "display", "size": 56, "line": 64, "weight": 300 },
      "h1":       { "family": "display", "size": 40, "line": 48, "weight": 300 },
      "h2":       { "family": "display", "size": 28, "line": 36, "weight": 400 },
      "h3":       { "family": "display", "size": 20, "line": 28, "weight": 500 },
      "body-lg":  { "family": "body", "size": 17, "line": 26, "weight": 400 },
      "body":     { "family": "body", "size": 15, "line": 22, "weight": 400 },
      "label":    { "family": "body", "size": 14, "line": 20, "weight": 600 },
      "caption":  { "family": "body", "size": 13, "line": 18, "weight": 500 },
      "overline": { "family": "body", "size": 12, "line": 16, "weight": 600, "letterSpacing": "0.12em", "textTransform": "uppercase" },
      "mono":     { "family": "mono", "size": 13, "line": 20, "weight": 500 }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" }
  },
  "radius": {
    "xs":      { "$type": "dimension", "$value": "6px" },
    "control": { "$type": "dimension", "$value": "10px" },
    "card":    { "$type": "dimension", "$value": "16px" },
    "sheet":   { "$type": "dimension", "$value": "24px" },
    "pill":    { "$type": "dimension", "$value": "999px" }
  },
  "size": {
    "touch-min":  { "$type": "dimension", "$value": "44px", "$description": "48dp on Android" },
    "control-md": { "$type": "dimension", "$value": "44px" },
    "control-sm": { "$type": "dimension", "$value": "32px" }
  },
  "shadow": {
    "raised": { "$type": "shadow", "$value": "0 8px 24px rgba(0,0,0,0.35), inset 0 0 0 1px rgba(230,234,240,0.08)" },
    "focus":  { "$type": "shadow", "$value": "0 0 0 2px var(--rd-surface), 0 0 0 4px var(--rd-focus-ring), 0 0 16px 4px rgba(127,178,255,0.45)" },
    "glow":   { "$type": "shadow", "$value": "drop-shadow(0 0 14px rgba(169,204,255,0.55))", "$description": "Mark only, dark grounds only." }
  },
  "motion": {
    "quick":    { "$type": "transition", "$value": { "duration": "120ms", "timingFunction": "ease-out" } },
    "standard": { "$type": "transition", "$value": { "duration": "200ms", "timingFunction": "cubic-bezier(0.2, 0, 0, 1)" } },
    "takeoff":  { "$type": "transition", "$value": { "duration": "320ms", "timingFunction": "cubic-bezier(0.3, 0, 0, 1)" } }
  }
}
