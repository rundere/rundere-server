{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "profile/traveller.json",
  "description": "Run·dere archive, format 1 (SPEC-13 §2, D-241). Strict: adding a field means editing this schema in the same change (§2.3).",
