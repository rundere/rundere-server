{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OWNER/yonder/schemas/travel-extraction.schema.json",
  "title": "TravelExtractionBatch",
  "description": "DERIVED \u2014 do not hand-edit. The ONLY object an extractor may emit. Always an array. CaptureContext is included as INPUT the extractor may read but must not invent: when the document lacks a date, list it in capture_required_fields rather than guessing. Home detection, geocoding and collection assignment remain resolver concerns and are stripped.",
  "x-derived-from": "https://github.com/OWNER/yonder/schemas/travel-item.schema.json",
  "x-schema-version": "1.4.0",
  "$ref": "#/$defs/PayloadBatch",
  "$defs": {
    "PayloadBatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "description": "THE LLM-CONSTRAINED ROOT. One document may contain many segments; the extractor MUST return an array even for a single item.",
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Payload"
          }
        },
        "declared_segment_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "Payload": {
      "type": "object",
      "description": "THE LLM-CONSTRAINED OBJECT. This subtree, and only this subtree, is what an extractor emits.",
      "required": [
        "item_type",
        "booking_status"
      ],
      "properties": {
        "item_type": {
          "$ref": "#/$defs/ItemType"
        },
        "booking_status": {
          "type": "string",
          "enum": [
            "planned",
            "confirmed",
            "changed",
            "cancelled",
            "pending",
            "unknown"
          ],
          "description": "A cancellation email is NOT a new item. It is this field set to cancelled on an existing canonical_key."
        },
        "booking_reference": {
          "type": [
            "string",
            "null"
          ],
          "description": "PNR / confirmation code."
        },
        "provider": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provider"
            },
            {
              "type": "null"
            }
          ]
        },
        "travelers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Traveler"
          },
          "default": []
        },
        "cost": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "flight": {
          "anyOf": [
            {
              "$ref": "#/$defs/FlightDetail"
            },
            {
              "type": "null"
            }
          ]
        },
        "ground_transport": {
          "anyOf": [
            {
              "$ref": "#/$defs/GroundDetail"
            },
            {
              "type": "null"
            }
          ]
        },
        "lodging": {
          "anyOf": [
            {
              "$ref": "#/$defs/LodgingDetail"
            },
            {
              "type": "null"
            }
          ]
        },
        "event": {
          "anyOf": [
            {
              "$ref": "#/$defs/EventDetail"
            },
            {
              "type": "null"
            }
          ]
        },
        "capture_required_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "x-owner": "extractor",
          "description": "Fields the extractor could NOT obtain from the document and which the capture client must supply. Non-empty + unsatisfied => needs_review."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "item_type": {
                "const": "flight"
              }
            },
            "required": [
              "item_type"
            ]
          },
          "then": {
            "required": [
              "flight"
            ],
            "properties": {
              "flight": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "item_type": {
                "const": "ground_transport"
              }
            },
            "required": [
              "item_type"
            ]
          },
          "then": {
            "required": [
              "ground_transport"
            ],
            "properties": {
              "ground_transport": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "item_type": {
                "const": "lodging"
              }
            },
            "required": [
              "item_type"
            ]
          },
          "then": {
            "required": [
              "lodging"
            ],
            "properties": {
              "lodging": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "item_type": {
                "const": "event"
              }
            },
            "required": [
              "item_type"
            ]
          },
          "then": {
            "required": [
              "event"
            ],
            "properties": {
              "event": {
                "type": "object"
              }
            }
          }
        }
      ]
    },
    "ItemType": {
      "type": "string",
      "enum": [
        "flight",
        "ground_transport",
        "lodging",
        "event",
        "note",
        "unknown"
      ]
    },
    "DateTimeLocal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local",
        "precision"
      ],
      "description": "Never a bare ISO string. AirTrail rejects the whole batch when a midnight default collides; forcing precision to be explicit makes that failure impossible to produce accidentally.",
      "properties": {
        "local": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}(:[0-9]{2})?)?$",
          "description": "Wall-clock time at the place. No offset. Date-only permitted when precision=date."
        },
        "precision": {
          "type": "string",
          "enum": [
            "datetime",
            "date",
            "unknown"
          ],
          "description": "date => time was genuinely absent from the source. NEVER synthesise 00:00 to satisfy a target."
        },
        "tz": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z_]+/[A-Za-z_+-]+$",
          "description": "IANA, single slash only. Two-slash zones (America/Argentina/Buenos_Aires) must be mapped to backward aliases before this field is set. Extractor sets if stated; resolver fills from place lookup."
        },
        "origin": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "document",
            "capture_context",
            "collection_default",
            "inferred",
            null
          ],
          "x-owner": "extractor",
          "description": "Where the date came from. capture_context = the human typed it. NEVER 'inferred' for a stored commit."
        }
      }
    },
    "Place": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw"
      ],
      "properties": {
        "raw": {
          "type": "string",
          "description": "Verbatim from source. Always retained."
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "iata": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$"
        },
        "icao": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{4}$"
        },
        "address": {
          "type": [
            "string",
            "null"
          ]
        },
        "city": {
          "type": [
            "string",
            "null"
          ]
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        },
        "country": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{2}$",
          "description": "ISO 3166-1 alpha-2."
        }
      }
    },
    "Provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "iata": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z0-9]{2}$"
        },
        "icao": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$"
        },
        "kind": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "airline",
            "rail",
            "bus",
            "ferry",
            "car_rental",
            "hotel",
            "ota",
            "ticketing",
            "other",
            null
          ]
        }
      }
    },
    "Traveler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_name"
      ],
      "properties": {
        "raw_name": {
          "type": "string",
          "description": "Verbatim, e.g. MEHTA/DANIELMR. Never normalised in place."
        },
        "given": {
          "type": [
            "string",
            "null"
          ],
          "x-owner": "extractor"
        },
        "family": {
          "type": [
            "string",
            "null"
          ],
          "x-owner": "extractor"
        }
      }
    },
    "Money": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": "number"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "FlightDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flight_number",
        "departure",
        "arrival"
      ],
      "description": "ONE SEGMENT. A multi-leg PNR fans out to N TravelItems sharing booking_group_id.",
      "properties": {
        "marketing_carrier": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provider"
            },
            {
              "type": "null"
            }
          ]
        },
        "operating_carrier": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provider"
            },
            {
              "type": "null"
            }
          ]
        },
        "flight_number": {
          "type": "string",
          "pattern": "^[0-9]{1,4}[A-Z]?$",
          "description": "Digits only. Carrier lives in marketing_carrier."
        },
        "leg_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "departure": {
          "$ref": "#/$defs/Movement"
        },
        "arrival": {
          "$ref": "#/$defs/Movement"
        },
        "aircraft": {
          "type": [
            "string",
            "null"
          ]
        },
        "registration": {
          "type": [
            "string",
            "null"
          ]
        },
        "cabin_class": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "economy",
            "premium_economy",
            "business",
            "first",
            null
          ]
        },
        "seats": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "ticket_numbers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "Movement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "place",
        "time"
      ],
      "properties": {
        "place": {
          "$ref": "#/$defs/Place"
        },
        "time": {
          "$ref": "#/$defs/DateTimeLocal"
        },
        "terminal": {
          "type": [
            "string",
            "null"
          ],
          "description": "Full value. AirTrail adapter clamps to 10 chars; schema does not."
        },
        "gate": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "GroundDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "departure",
        "arrival"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "train",
            "bus",
            "ferry",
            "car",
            "car_rental",
            "rideshare",
            "transfer",
            "walk",
            "other"
          ]
        },
        "service_number": {
          "type": [
            "string",
            "null"
          ]
        },
        "departure": {
          "$ref": "#/$defs/Movement"
        },
        "arrival": {
          "$ref": "#/$defs/Movement"
        },
        "coach": {
          "type": [
            "string",
            "null"
          ]
        },
        "seats": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "waypoints": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Movement"
          },
          "description": "Intermediate stops, in travel order. Each MAY become its own Location; home-radius waypoints are suppressed like any other."
        },
        "route": {
          "anyOf": [
            {
              "$ref": "#/$defs/RouteDetail"
            },
            {
              "type": "null"
            }
          ]
        },
        "round_trip": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Origin and destination are the same place (typical home-out-and-back drive)."
        }
      }
    },
    "RouteDetail": {
      "type": "object",
      "additionalProperties": false,
      "description": "Planning-time estimate from a directions provider. NOT actuals \u2014 Dawarich owns the raw GPS timeline. This is the intended route only.",
      "properties": {
        "provider": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "google_maps",
            "apple_maps",
            "osrm",
            "manual",
            null
          ]
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "distance_km": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "duration_minutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "polyline": {
          "type": [
            "string",
            "null"
          ],
          "description": "Encoded polyline. Optional; large."
        },
        "is_estimate": {
          "type": "boolean",
          "default": true
        },
        "captured_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "LodgingDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "property_name",
        "place",
        "check_in",
        "check_out"
      ],
      "properties": {
        "property_name": {
          "type": "string"
        },
        "lodging_kind": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "hotel",
            "hostel",
            "apartment",
            "house",
            "bnb",
            "camping",
            "cabin",
            "other",
            null
          ]
        },
        "place": {
          "$ref": "#/$defs/Place"
        },
        "check_in": {
          "$ref": "#/$defs/DateTimeLocal"
        },
        "check_out": {
          "$ref": "#/$defs/DateTimeLocal"
        },
        "room_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "guest_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "EventDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "start"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "category": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "concert",
            "sport",
            "theatre",
            "dining",
            "tour",
            "museum",
            "conference",
            "meeting",
            "other",
            null
          ]
        },
        "venue": {
          "anyOf": [
            {
              "$ref": "#/$defs/Place"
            },
            {
              "type": "null"
            }
          ]
        },
        "start": {
          "$ref": "#/$defs/DateTimeLocal"
        },
        "end": {
          "anyOf": [
            {
              "$ref": "#/$defs/DateTimeLocal"
            },
            {
              "type": "null"
            }
          ]
        },
        "all_day": {
          "type": "boolean",
          "default": false
        },
        "organizer": {
          "type": [
            "string",
            "null"
          ]
        },
        "attendees": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "seats": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "gcal_event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "gcal_recurring": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "CaptureContext": {
      "type": "object",
      "additionalProperties": false,
      "x-owner": "ingest",
      "description": "Metadata supplied BY THE HUMAN at submission time, not derived from the document. Required for sources that carry no date \u2014 a Google Maps directions URL has an origin, waypoints and destination and nothing else. The capture client must collect this before POSTing.",
      "properties": {
        "travel_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "Date of travel. Mandatory for maps captures."
        },
        "travel_time": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{2}:[0-9]{2}$",
          "description": "Optional. Absent => DateTimeLocal.precision=date, never defaulted to 00:00."
        },
        "end_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "For multi-day drives."
        },
        "collection_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "User-selected AdventureLog collection. When present the resolver SKIPS the match ladder \u2014 the human already decided. This is the normal path for road trips: collection created in advance to book time off, drive plan attached later."
        },
        "timezone": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z_]+/[A-Za-z_+-]+$"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "traveler_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Alias ids chosen from a picker. Drives have no passenger manifest."
        },
        "item_type_hint": {
          "$ref": "#/$defs/ItemType"
        },
        "mode": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "car",
            "transit",
            "walk",
            null
          ],
          "description": "Directions captures only: the travel mode chosen on the capture surface, cross-checked against the URL's own mode signal (SPEC-4 D-91). Absent => car."
        },
        "submitted_by": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}